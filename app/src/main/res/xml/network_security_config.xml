<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!--
        Certificate pins are no longer here: TigerSync publishes them as a signed
        document that can change at runtime, so :shared's PinnedTrustManager
        applies them on top of this config's system trust, with BuiltInPins as
        the fallback (TLS pins spec, A9). This file keeps only the cleartext
        rules and the system-only trust anchors.
    -->

    <!-- NTUST's hosts receive SSO credentials and a long-lived Moodle wstoken:
         HTTPS only. Pinned in code, BuiltInPins' "ntust" set. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ntust.edu.tw</domain>
    </domain-config>

    <!-- The library: HTTPS only. Pinned in code, BuiltInPins' "library" set. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.lib.ntust.edu.tw</domain>
    </domain-config>

    <!-- Local dev backends over HTTP. Debug builds default PUSH_BASE_URL to
         http://10.0.2.2:40000 (the emulator's host-loopback) so a dev build
         never silently hits production. Only these loopback/emulator hosts get
         cleartext; the base-config keeps it off everywhere else, and Release
         talks HTTPS to api.tigerduck.app and never connects here. Physical-
         device devs: add your Mac's LAN IP (e.g. 192.168.x.x) below. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
