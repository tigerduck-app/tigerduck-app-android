<?xml version="1.0" encoding="utf-8"?>
<!-- Every file the app hands to another app, through the one FileProvider in the manifest. -->
<paths>
    <!-- Opened School Mail attachments (MailCache.attachmentsDir = cacheDir/mail/attachments). -->
    <cache-path name="mail_attachments" path="mail/attachments/" />
    <!-- Downloaded Moodle files (DataCache.moodleDownloadsRoot = filesDir/moodle_files). -->
    <files-path name="moodle_downloads" path="moodle_files/" />
    <!-- Exported class table images (ClassTableExport.kt). -->
    <cache-path name="class_table_export" path="class_table_export/" />
    <!-- Photos taken for a page's upload field in the TigerDuck browser (InAppBrowserActivity.UPLOADS_DIR). -->
    <cache-path name="browser_uploads" path="browser_uploads/" />
    <!-- Files the file viewer took out of an archive to show (ArchiveCache in ArchiveViewer.kt). -->
    <cache-path name="archive_entries" path="archive_entries/" />
    <!-- Debug builds' file viewer samples and files picked to try in the viewer (ViewerSamples).
         Nothing writes here in a release build. -->
    <cache-path name="viewer_samples" path="viewer_samples/" />
</paths>
