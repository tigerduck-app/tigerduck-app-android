<?xml version="1.0" encoding="utf-8"?><!--
    DEBUG-ONLY override of the production network-security config. Identical
    to main/res/xml/network_security_config.xml except the base-config below
    permits cleartext so the Settings → Developer → API endpoint override
    can point at any LAN dev backend (e.g. http://192.168.X.X:40000/v2)
    without rejecting at the OS layer. Pinned NTUST hosts further down still
    require HTTPS — the base only applies to hosts without a domain-config.
    Release builds use the locked-down main/ variant.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />

    <!--
        Pinned hosts receive NTUST SSO credentials and a long-lived Moodle wstoken.
        Pins are SHA-256 of SubjectPublicKeyInfo. Each set includes the leaf SPKI
        plus the issuing intermediate CA SPKI as a rotation-safe backup.

        Rotation before expiration is MANDATORY — after the expiration date the
        pins stop enforcing and fall back to system CA trust.

        To re-pin, run (replace host as needed):
            echo | openssl s_client -servername HOST -connect HOST:443 -showcerts \
              | openssl x509 -noout -pubkey | openssl pkey -pubin -outform der \
              | openssl dgst -sha256 -binary | openssl enc -base64
    -->

    <!-- *.ntust.edu.tw wildcard leaf + TWCA Secure SSL intermediate.
         Leaf cert expires 2027-02-18; pins expire a month earlier. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ntust.edu.tw</domain>
        <pin-set expiration="2027-01-18">
            <pin digest="SHA-256">Nz3wUtBXZ+2HPXuSyx4enXs62i/PH4MKtayV9N4X0PE=</pin>
            <pin digest="SHA-256">9VZ7Yd685RTXsE6rL/puuMbnejYaXwaZasGL7c+Uolc=</pin>
        </pin-set>
    </domain-config>

    <!-- api.lib.ntust.edu.tw leaf + intermediate. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.lib.ntust.edu.tw</domain>
        <pin-set expiration="2027-01-18">
            <pin digest="SHA-256">m8Epf0KqJFv9abCXfipePZ79hfOMjddCKxz+RSZIDKY=</pin>
            <pin digest="SHA-256">ZSagvDzjltLkewXEBuDxIzpW/dpVw1Juvvmd0hhkzdY=</pin>
        </pin-set>
    </domain-config>

    <!-- cardsystem.ntust.edu.tw (student ID card system) leaf + intermediate.
         Its own dedicated cert, not the *.ntust.edu.tw wildcard above — issued
         through a different chain (TWCA SSL Certification Authority / TWCA
         CYBER Root CA, vs the wildcard's TWCA Secure SSL Certification
         Authority / TWCA Global Root CA), so without this entry the
         ntust.edu.tw pin-set above always rejected it.
         Leaf cert expires 2027-04-07; pins expire a month earlier. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">cardsystem.ntust.edu.tw</domain>
        <pin-set expiration="2027-03-07">
            <pin digest="SHA-256">9d/JLaocYyB3ZnEkZvr/kVMudGX8tmPAx5ryrhmqq28=</pin>
            <pin digest="SHA-256">BxOmElsPeD54MBOb5h+TPNJnBlsAk6spRc/wLnko0cc=</pin>
        </pin-set>
    </domain-config>

    <!-- App's own backend: cleartext still blocked but not pinned. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">r.xinshou.tw</domain>
    </domain-config>
</network-security-config>
