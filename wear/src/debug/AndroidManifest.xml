<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Lets `adb shell am broadcast` fake the library pass for store
            screenshots. Exported because a broadcast from the `shell` uid
            cannot reach an unexported receiver. Debug source set only, so no
            such component exists in the release APK.
        -->
        <receiver
            android:name="org.ntust.app.tigerduck.wear.debug.WearFixtureReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.ntust.app.tigerduck.debug.LOAD_FIXTURE" />
                <action android:name="org.ntust.app.tigerduck.debug.CLEAR_FIXTURE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
